<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Platforms>AnyCPU;x64</Platforms>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PackageId>FastFind.Windows</PackageId>
    <Title>FastFind.NET Windows</Title>
  </PropertyGroup>

  <!-- Make internal types visible to test project -->
  <ItemGroup>
    <InternalsVisibleTo Include="FastFind.Windows.Tests" />
    <InternalsVisibleTo Include="FastFind.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\DirectAttributes.cs" Link="Shared\DirectAttributes.cs" />
    <Compile Include="..\Shared\FileEntryTable.cs" Link="Shared\FileEntryTable.cs" />
    <Compile Include="..\Shared\SearchTimingTally.cs" Link="Shared\SearchTimingTally.cs" />
    <Compile Include="..\Shared\IndexingAdmission.cs" Link="Shared\IndexingAdmission.cs" />
    <Compile Include="..\Shared\ResultCap.cs" Link="Shared\ResultCap.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastFind\FastFind.csproj" />
  </ItemGroup>

</Project>
