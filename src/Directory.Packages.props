<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Microsoft.Extensions (.NET 10)">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Label="System Libraries (.NET 10)">
    <PackageVersion Include="System.Management" Version="10.0.12" />
    <PackageVersion Include="System.Diagnostics.PerformanceCounter" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Label="Database">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Referenced directly rather than inherited: Microsoft.Data.Sqlite 10.0.12 resolves
         SQLitePCLRaw 2.1.12 on its own, which clears CVE-2025-6965 (GHSA-2m69-gcr7-jv3q, affects
         <= 2.1.11) but still ships an older native build. 3.0.5 carries SQLite 3.53.4. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
  <ItemGroup Label="Testing Framework">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>
  <ItemGroup Label="Testing Utilities">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.15.8" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
  </ItemGroup>
</Project>