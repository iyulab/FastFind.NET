<Project>
  <!-- Common Build Properties -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- What a consumer gets beside the assembly: IntelliSense documentation, and symbols that step into
       the source at the commit that was built. Test and benchmark projects switch the first off. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: "missing XML comment" on every public member. The public surface is documented where it has something to say. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Paths in the symbols are made deterministic only on CI, so a local build still debugs against local paths. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Package Information -->
  <PropertyGroup>
    <Version>2.5.0</Version>
    <Description>Cross-platform file search library for .NET: SIMD-accelerated matching, a compact in-memory index, optional SQLite persistence, and real-time change monitoring — on Windows via the NTFS change journal, on Linux and macOS via the platform watchers</Description>
    <PackageTags>file-search;indexing;fast;cross-platform;ntfs;mft;sqlite;usn-journal</PackageTags>
    <PackageProjectUrl>https://github.com/iyulab/FastFind.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/iyulab/FastFind.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>logo.png</PackageIcon>
  </PropertyGroup>

  <!-- Author Information -->
  <PropertyGroup>
    <Authors>iyulab</Authors>
    <Copyright>Copyright (c) Iyulab Corporation 2025.</Copyright>
  </PropertyGroup>

  <!-- Package Assets -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
